{
  "name": "repoprompt-ce-user-docs",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm",
  "engines": {
    "node": "26",
    "pnpm": "12"
  },
  "scripts": {
    "start": "node scripts/verify-toolchain.cjs --versions-only && docusaurus start",
    "build": "node scripts/verify-toolchain.cjs && pnpm test && pnpm run check:content && docusaurus build && node scripts/finalize-redirects.cjs && node scripts/finalize-llm-exports.cjs && pnpm run check:artifacts && pnpm run check:integration",
    "check:artifacts": "node scripts/verify-toolchain.cjs --versions-only && node scripts/check-artifacts.cjs",
    "test": "node scripts/verify-toolchain.cjs --versions-only && node --test tests/*.test.cjs",
    "check:content": "node scripts/verify-toolchain.cjs --versions-only && node migration/check-docs.cjs",
    "check:integration": "node scripts/verify-toolchain.cjs --versions-only && node scripts/check-integration.cjs",
    "verify:toolchain": "node scripts/verify-toolchain.cjs",
    "preinstall": "node scripts/verify-toolchain.cjs --versions-only",
    "setup:native": "node scripts/verify-toolchain.cjs --versions-only && pnpm rebuild --ignore-scripts=false sharp @swc/core && pnpm run verify:toolchain",
    "serve": "node scripts/verify-toolchain.cjs --versions-only && docusaurus serve",
    "clear": "node scripts/verify-toolchain.cjs --versions-only && docusaurus clear"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/plugin-client-redirects": "3.10.2",
    "@docusaurus/plugin-ideal-image": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "3.1.1",
    "cosmos-docusaurus-theme": "2.2.6",
    "docusaurus-plugin-copy-page-button": "0.8.4",
    "docusaurus-plugin-llms": "0.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "browserslist": [
    "defaults and supports css-cascade-layers"
  ]
}
