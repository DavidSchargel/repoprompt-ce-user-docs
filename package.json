{
  "name": "repoprompt-ce-user-docs",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate:favicons": "node scripts/generate-favicons.cjs",
    "start": "docusaurus start",
    "build": "pnpm test && pnpm run check:content && docusaurus build && node scripts/finalize-redirects.cjs && node scripts/finalize-llm-exports.cjs && pnpm run check:artifacts",
    "check:artifacts": "node scripts/check-artifacts.cjs",
    "test": "node --test tests/*.test.cjs",
    "check:content": "node scripts/check-content.cjs",
    "setup:native": "pnpm rebuild --ignore-scripts=false sharp @swc/core",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/plugin-client-redirects": "3.10.2",
    "@docusaurus/plugin-ideal-image": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "3.1.1",
    "cosmos-docusaurus-theme": "2.2.6",
    "docusaurus-plugin-copy-page-button": "0.8.4",
    "docusaurus-plugin-image-zoom": "3.0.1",
    "docusaurus-plugin-llms": "0.6.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "5.7.0",
    "react-tweet": "3.3.1"
  },
  "browserslist": [
    "defaults and supports css-cascade-layers"
  ],
  "license": "Apache-2.0"
}
